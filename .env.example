# PathAI Environment Variables
# Copy this file to .env and fill in your API keys.

# --- LLM API Keys ---
# Primary: Gemini (supports comma-separated keys for rotation)
# Get free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Fast fallback: Groq (free, ultra-fast)
# Get free key at: https://console.groq.com
GROQ_API_KEY=

# Fallback: OpenAI
OPENAI_API_KEY=

# Fallback: Anthropic
ANTHROPIC_API_KEY=

# Override the default model (optional)
# LLM_MODEL=gemini-2.0-flash

# --- Server Config ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
